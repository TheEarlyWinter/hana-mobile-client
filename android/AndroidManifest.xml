<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.hanamobile.app"
    android:versionCode="4"
    android:versionName="0.4">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="36" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 回合完成时的本地通知。targetSdk 33+ 必须有这个运行时权限，否则
         NotificationManager.notify 静默失败；minSdk 26 的老系统不声明权限也能用，
         所以壳里在 API < 33 时直接按系统通知开关回答，不弹权限框。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- targetSdk 30+ 的包可见性：不声明就 resolveActivity 不到相机 -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher_bot"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:hardwareAccelerated="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|smallestScreenSize"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 只给相机 App 临时授权的私有文件区，不对外导出 -->
        <provider
            android:name=".FileStoreProvider"
            android:authorities="com.hanamobile.app.files"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
